<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jujava.mediturnos.presentacion.controladores.GestionarTurnosViewController">
    <children>
        <Label styleClass="view-title" text="Gestión de Turnos (Administrador)" />

        <TableView fx:id="tblTurnos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdTurno" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colFechaHora" prefWidth="120.0" text="Fecha y Hora" />
                <TableColumn fx:id="colEspecialidad" prefWidth="100.0" text="Especialidad" />
                <TableColumn fx:id="colPaciente" prefWidth="150.0" text="Paciente" />
                <TableColumn fx:id="colDniPaciente" prefWidth="80.0" text="DNI Pac." />
                <TableColumn fx:id="colMedico" prefWidth="150.0" text="Médico" />
                <TableColumn fx:id="colDniMedico" prefWidth="80.0" text="DNI Méd." />
                <TableColumn fx:id="colEstado" prefWidth="80.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnModificarTurno" mnemonicParsing="false" onAction="#handleModificarTurno" styleClass="button-primary" text="Modificar Turno Seleccionado" disable="true" />
                <Button fx:id="btnCancelarTurno" mnemonicParsing="false" onAction="#handleCancelarTurno" styleClass="button-danger" text="Cancelar Turno Seleccionado" disable="true" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
