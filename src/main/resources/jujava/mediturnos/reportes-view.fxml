<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>


<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jujava.mediturnos.presentacion.controladores.ReportesViewController">
    <children>
        <Label styleClass="view-title" text="Reportes y Estadísticas" />

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Fecha Inicio:" />
                <DatePicker fx:id="dtpFechaInicio" promptText="Opcional" />
                <Label text="Fecha Fin:" />
                <DatePicker fx:id="dtpFechaFin" promptText="Opcional" />
                <Button fx:id="btnGenerar" mnemonicParsing="false" onAction="#handleGenerarReporte" styleClass="button-primary" text="Generar Reporte" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="30.0">
            <children>
                <Label styleClass="view-header" text="Tasa de Asistencia:" />

                <Label fx:id="lblTasaAsistencia" text="N/A" styleClass="reporte-asistencia" />

                <Label styleClass="view-header" text="Tasa de Cancelación:" />

                <Label fx:id="lblTasaCancelacion" text="N/A" styleClass="reporte-cancelacion" />
            </children>
            <padding>
                <Insets top="5.0" />
            </padding>
        </HBox>

        <GridPane hgap="10.0" vgap="10.0" VBox.vgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
            </rowConstraints>

            <children>
                <VBox spacing="5.0" GridPane.columnIndex="0">
                    <Label text="Por Especialidad" styleClass="view-header"/>
                    <TableView fx:id="tblEspecialidad" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colEspecialidadDesc" prefWidth="100.0" text="Especialidad" />
                            <TableColumn fx:id="colEspecialidadCant" prefWidth="50.0" text="Cantidad" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox spacing="5.0" GridPane.columnIndex="1">
                    <Label text="Por Médico" styleClass="view-header"/>
                    <TableView fx:id="tblMedico" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colMedicoDesc" prefWidth="100.0" text="Médico" />
                            <TableColumn fx:id="colMedicoCant" prefWidth="50.0" text="Cantidad" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox spacing="5.0" GridPane.columnIndex="2">
                    <Label text="Por Estado" styleClass="view-header"/>
                    <TableView fx:id="tblEstado" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colEstadoDesc" prefWidth="100.0" text="Estado" />
                            <TableColumn fx:id="colEstadoCant" prefWidth="50.0" text="Cantidad" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox spacing="5.0" GridPane.columnIndex="3">
                    <Label text="Por Obra Social" styleClass="view-header"/>
                    <TableView fx:id="tblObraSocial" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colObraSocialDesc" prefWidth="100.0" text="Obra Social" />
                            <TableColumn fx:id="colObraSocialCant" prefWidth="50.0" text="Cantidad" />
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                    </TableView>
                </VBox>
            </children>
        </GridPane>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button fx:id="btnExportarExcel" mnemonicParsing="false" onAction="#handleExportarExcel" styleClass="button-primary" text="Exportar a Excel" disable="true" />
            </children>
        </HBox>

    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>