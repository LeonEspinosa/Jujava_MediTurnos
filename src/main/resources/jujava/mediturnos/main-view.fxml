<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="600.0" minWidth="800.0" prefHeight="768.0" prefWidth="1024.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jujava.mediturnos.presentacion.controladores.MainViewController">
    <left>

        <VBox fx:id="menuBox" prefWidth="180.0" spacing="10.0" styleClass="menu-bar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="menu-header" text="Gestión de Usuarios">
                </Label>
                <Separator prefWidth="200.0" />
                <Button fx:id="btnListar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleListar" styleClass="menu-button" text="Listar / Buscar" />
                <Button fx:id="btnRegistro" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleRegistro" styleClass="menu-button" text="Registro (Alta)" />
                <Button fx:id="btnModificar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleModificacion" styleClass="menu-button" text="Modificación" />

                <Separator prefWidth="200.0" />

                <VBox fx:id="menuUsuarioAdmin" spacing="10.0" managed="false" visible="false">
                    <Label styleClass="menu-header" text="Gestión de Turnos (Admin)" />
                    <Button fx:id="btnGestionarTurnos" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleGestionarTurnos" styleClass="menu-button" text="Gestionar Turnos" />
                    <Button fx:id="btnReportes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleReportes" styleClass="menu-button" text="Reportes y Stats" />
                    <Button fx:id="btnGestionarEspecialidades" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleGestionarEspecialidades" styleClass="menu-button" text="Gestionar Especialidades" />
                    <padding>
                        <Insets top="5.0" />
                    </padding>
                </VBox>

                <VBox fx:id="menuUsuarioMedico" spacing="10.0" managed="false" visible="false">
                    <Label styleClass="menu-header" text="Gestión de Turnos (Médico)" />
                    <Button fx:id="btnMiAgenda" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMiAgenda" styleClass="menu-button" text="Mi Agenda" />
                    <padding>
                        <Insets top="5.0" />
                    </padding>
                </VBox>

                <VBox fx:id="menuUsuarioPaciente" spacing="10.0" managed="false" visible="false">
                    <Label styleClass="menu-header" text="Gestión de Turnos (Paciente)" />
                    <Button fx:id="btnSolicitarTurno" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSolicitarTurno" styleClass="menu-button" text="Solicitar Turno" />
                    <padding>
                        <Insets top="5.0" />
                    </padding>
                </VBox>

                <VBox VBox.vgrow="ALWAYS" />

                <Separator prefWidth="200.0" />
                <Button fx:id="btnSalir" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSalir" styleClass="menu-button-danger" text="Salir" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>

    </left>
    <center>
        <BorderPane fx:id="contentArea" prefHeight="200.0" prefWidth="200.0">
            <bottom>
                <Label fx:id="lblUsuarioLogueado" text="Usuario no identificado" BorderPane.alignment="CENTER_LEFT">
                    <padding>
                        <Insets left="10.0" bottom="5.0" />
                    </padding>
                </Label>
            </bottom>
        </BorderPane>
    </center>
</BorderPane>