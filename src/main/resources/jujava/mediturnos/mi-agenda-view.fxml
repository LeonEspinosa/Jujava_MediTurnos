<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jujava.mediturnos.presentacion.controladores.MiAgendaViewController">
    <children>
        <Label styleClass="view-title" text="Mi Agenda (Turnos Asignados)" />

        <TableView fx:id="tblTurnos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIdTurno" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="colFechaHora" prefWidth="150.0" text="Fecha y Hora" />
                <TableColumn fx:id="colPaciente" prefWidth="200.0" text="Paciente" />
                <TableColumn fx:id="colDniPaciente" prefWidth="100.0" text="DNI Paciente" />
                <TableColumn fx:id="colEspecialidad" prefWidth="150.0" text="Especialidad" />
                <TableColumn fx:id="colEstado" prefWidth="100.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <children>
                <Button fx:id="btnCompletarTurno" mnemonicParsing="false" onAction="#handleCompletarTurno" styleClass="button-primary" text="Marcar como Realizado" disable="true" />
            </children>
        </HBox>

    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>